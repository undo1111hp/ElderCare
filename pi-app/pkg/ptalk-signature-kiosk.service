[Unit]
Description=PTalk Signature kiosk (fullscreen on the DSI display)
After=systemd-user-sessions.service network-online.target sound.target
Wants=network-online.target

[Service]
User=eldercare
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=wayland
# cage is a single-app Wayland kiosk compositor; -s keeps it alive on exit.
ExecStart=/usr/bin/cage -s -- /usr/bin/ptalk-signature
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
